{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/cli.ts", "src/game"],
  "exclude": ["src/game/sprites.ts", "src/game/nodeSprites.ts", "src/game/itemSprites.ts", "src/game/bardSprites.ts"]
}
